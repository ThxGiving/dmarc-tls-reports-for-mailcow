[Unit]
Description=mailcow report dashboard – process newly delivered reports
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# give bursts of reports a moment to arrive, then process them in one go
ExecStartPre=/bin/sleep 15
ExecStart=/usr/bin/python3 /opt/mailcow-reports/mailcow_reports.py
Nice=10
# hardening: needs docker (doveadm via docker compose) and systemctl (new-mail watch), so it runs as
# root; everything else is fenced off and bounded
TimeoutStartSec=30min
MemoryMax=1G
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077
